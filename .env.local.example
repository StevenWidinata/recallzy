# Copy this file to .env.local and fill in the values.

# Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Gemini (get a free key at https://aistudio.google.com)
GEMINI_API_KEY=
# Optional: extra keys, comma-separated. When one key runs out of quota, the next is used.
# Only keys from DIFFERENT Google Cloud projects add quota (keys in one project share it).
GEMINI_API_KEYS=
# Preferred model. If it's out of quota, slow or down, Recallzy automatically falls back to
# gemini-3.6-flash → gemini-3.5-flash-lite → gemini-3.1-flash-lite (each has its own free quota).
GEMINI_MODEL=gemini-3.5-flash
# Optional: replace the whole fallback list, comma-separated, tried in order.
GEMINI_MODELS=

# How many new quizzes each user can generate per day with the shared key
DAILY_QUIZ_LIMIT=5
